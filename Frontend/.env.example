# Copy to .env and adjust. Only variables prefixed with VITE_ reach the browser.

# Base URL the frontend calls. Keep "/api" in dev (Vite proxies it to the backend).
VITE_API_BASE_URL=/api

# Where Vite forwards /api in dev (dev-server only, not exposed to the browser).
VITE_API_PROXY_TARGET=http://localhost:8000
