PORT=8000
DATABASE_URL=postgresql://postgres:password@localhost:5432/vedora_db
JWT_SECRET=supersecretjwtkey_change_in_production
CORS_ORIGIN=https://vedoraofficial.com,https://www.vedoraofficial.com,http://localhost:5173

# Razorpay Configuration (Orders Pay-in, Wallet Top-up & RazorpayX Payouts)
# Obtain API Keys & Account Number from Razorpay Dashboard (https://dashboard.razorpay.com/)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_ACCOUNT_NUMBER= # RazorpayX Current / Virtual Account number (for Payouts)
RAZORPAY_ENV=TEST # Options: TEST | LIVE
RAZORPAY_WEBHOOK_SECRET=

# Cashfree Verification Suite Configuration (Penny Drop Bank Verification)
# Obtain credentials from Cashfree Merchant Dashboard (https://merchant.cashfree.com/)
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENV=SANDBOX # Options: SANDBOX | PRODUCTION
CASHFREE_NAME_MATCH_THRESHOLD=60 # Minimum fuzzy match score (0-100) to mark as VERIFIED

# Shiprocket Delivery & Tracking Configuration
# Obtain credentials from Shiprocket Dashboard (https://app.shiprocket.in/)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in/v1/external

# ApiTxt OTP Gateway Configuration (https://apitxt.com/)
# Set your APITXT_AUTH_KEY to activate live OTP delivery. When empty, simulated delivery is used.
APITXT_AUTH_KEY=
APITXT_BASE_URL=https://apitxt.com/api/sendOTP
APITXT_DEFAULT_COUNTRY=91
APITXT_CHANNEL=sms
# Optional: Set when custom templates or projects are approved (leaves default if empty)
APITXT_TEMPLATE_ID=
APITXT_TEMPLATE_NAME=
APITXT_PROJECT_REF_ID=

SMTP_USER=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
FRONTEND_URL=https://vedoraofficial.com

# GST invoice (PDF emailed when an order is paid). Confirm HSN and GST rate with your CA.
COMPANY_LEGAL_NAME=VEDORA
COMPANY_ADDRESS=
COMPANY_STATE=Maharashtra
COMPANY_GSTIN=
INVOICE_HSN_CODE=7117
INVOICE_GST_RATE=3
